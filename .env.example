# =============================================================================
# SQL Server 2022 Docker Deployment - Environment Configuration Template
# =============================================================================
#
# HOW TO USE:
#   cp .env.example .env
#   chmod 600 .env
#   nano .env   # or your editor of choice
#
# The real .env file is intentionally excluded from version control (see
# .gitignore). Never commit a populated .env file to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# MSSQL_SA_PASSWORD
# -----------------------------------------------------------------------------
# Password for the SQL Server "sa" (system administrator) login.
#
# SQL Server strong password requirements (enforced by the container at
# startup - it will refuse to start if these are not met):
#   - At least 8 characters long (16+ strongly recommended)
#   - Contains characters from at least 3 of these 4 categories:
#       1. Uppercase letters (A-Z)
#       2. Lowercase letters (a-z)
#       3. Base-10 digits (0-9)
#       4. Symbols (e.g. !, $, #, %, ^, &, *)
#   - Must NOT contain the word "password"
#   - Must NOT be a weak/common/easily guessed password
#
# Do not reuse this password anywhere else. Prefer a generated passphrase,
# e.g. via: openssl rand -base64 24
# -----------------------------------------------------------------------------
MSSQL_SA_PASSWORD=ReplaceWithAStrongPassword

# -----------------------------------------------------------------------------
# MSSQL_PORT
# -----------------------------------------------------------------------------
# Host-side TCP port that will be bound to the container's SQL Server port
# (1433 inside the container). This is bound to 127.0.0.1 only by default
# in docker-compose.yml, meaning it is NOT reachable from other machines
# unless you deliberately change the port binding.
# -----------------------------------------------------------------------------
MSSQL_PORT=1433

# -----------------------------------------------------------------------------
# MSSQL_DATABASE
# -----------------------------------------------------------------------------
# Default/reference database name used by helper scripts when no database
# is explicitly specified. This does not create a database by itself.
# -----------------------------------------------------------------------------
MSSQL_DATABASE=master

# -----------------------------------------------------------------------------
# MSSQL_USER
# -----------------------------------------------------------------------------
# Administrative login used by scripts to connect to SQL Server.
# For anything beyond initial setup and administration, create a
# dedicated least-privilege SQL login instead of using "sa".
# -----------------------------------------------------------------------------
MSSQL_USER=sa
